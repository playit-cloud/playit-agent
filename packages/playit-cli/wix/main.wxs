<!--
  Design notes for the Windows installer:

  * Everything is per-machine, so installs by a different admin, winget, or deployment
    tools behave the same as a double-click. The two shortcut components keep HKCU key
    paths only because ICE38 requires it for Start menu/Desktop folders; the shortcuts are
    not advertised, so those key paths never trigger an install repair.
  * There are no setup custom actions. The playitd service configures itself every time
    it starts (recovery actions, who may start/stop it, data folder permissions, 0.17
    secret migration), which is idempotent and logged.
  * The tray starts for every user through HKLM\...\Run. Users can opt out from the tray
    menu ("Launch at Login"); the choice is stored per user.
  * The only custom actions launch the tray after install so the icon appears right away.

  Variables provided by cargo-wix: TargetTriple, TargetEnv, TargetVendor,
  CargoTargetBinDir, CargoTargetDir, CargoProfile, Version.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<?define BinDir = "$(var.CargoTargetDir)\$(var.TargetTriple)\$(var.CargoProfile)" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Product
        Id="*"
        Name="playit"
        UpgradeCode="2640FEA4-3120-4DB0-93A9-6B04A4EFE7D2"
        Manufacturer="Developed Methods LLC"
        Language="1033"
        Codepage="1252"
        Version="$(var.Version)">

        <Package Id="*"
            Keywords="Installer"
            Manufacturer="Developed Methods LLC"
            InstallerVersion="500"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            SummaryCodepage="1252"
            />

        <!-- Remove the old version first so its service is stopped and deleted before ours is created. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes"
            AllowDowngrades="no"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."/>

        <!-- Close our UI processes so files are never in use; they are relaunched after install. -->
        <util:CloseApplication
            Id="ClosePlayitTray"
            Target="playitd-tray.exe"
            CloseMessage="yes"
            RebootPrompt="no"
            TerminateProcess="0"
            Timeout="5" />
        <util:CloseApplication
            Id="ClosePlayitCli"
            Target="playit.exe"
            RebootPrompt="no"
            TerminateProcess="0" />

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1"/>
        <Property Id="DiskPrompt" Value="Playit Installation"/>
        <Property Id="MsiLogging" Value="voicewarmupx"/>
        <Property Id="ARPURLINFOABOUT" Value="https://playit.gg"/>
        <Property Id="ARPHELPLINK" Value="https://playit.gg/support"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramMenuFolder">
                <Component Id="StartMenuShortcut" Guid="DA0CF511-6CBD-4C28-AF72-2DF8A72D1BE5">
                    <Shortcut Id="StartMenuShortcut"
                              Name="Playit.gg"
                              Description="Makes local ports public. Put your game servers online."
                              Icon="ProductICO"
                              Target="[Bin]playitd-tray.exe"
                              Arguments="--open"
                              WorkingDirectory="Bin"/>
                    <RegistryValue Root="HKCU" Key="Software\DevelopedMethodsLLC\playit_gg" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
                </Component>
            </Directory>

            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="DesktopShortcut" Guid="BF3DEFB0-E29B-4E8F-BDFB-BED82B50E0ED">
                    <Shortcut Id="DesktopShortcut"
                              Name="Playit.gg"
                              Description="Makes local ports public. Put your game servers online."
                              Icon="ProductICO"
                              Target="[Bin]playitd-tray.exe"
                              Arguments="--open"
                              WorkingDirectory="Bin"/>
                    <RegistryValue Root="HKCU" Key="Software\DevelopedMethodsLLC\playit_gg" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
                </Component>
            </Directory>

            <Directory Id="$(var.PlatformProgramFilesFolder)" Name="PFiles">
                <Directory Id="APPLICATIONFOLDER" Name="playit_gg">
                    <Directory Id="Bin" Name="bin">
                        <Component Id="Path" Guid="4472FB0A-A399-4967-99BD-E330FB737CE4" KeyPath="yes">
                            <Environment
                                Id="PATH"
                                Name="PATH"
                                Value="[Bin]"
                                Permanent="no"
                                Part="last"
                                Action="set"
                                System="yes"/>
                        </Component>

                        <Component Id="PlayitCli" Guid="*">
                            <File
                                Id="PlayitCliExe"
                                Name="playit.exe"
                                DiskId="1"
                                Source="$(var.CargoTargetBinDir)\playit-cli.exe"
                                KeyPath="yes"/>
                        </Component>

                        <Component Id="PlayitTray" Guid="*">
                            <File
                                Id="PlayitTrayExe"
                                Name="playitd-tray.exe"
                                DiskId="1"
                                Source="$(var.BinDir)\playitd-tray.exe"
                                KeyPath="yes"/>
                            <RegistryValue
                                Root="HKLM"
                                Key="Software\Microsoft\Windows\CurrentVersion\Run"
                                Name="playit"
                                Type="string"
                                Value="&quot;[#PlayitTrayExe]&quot; --autostart"/>
                        </Component>

                        <Component Id="PlayitDaemon" Guid="*">
                            <File
                                Id="PlayitDaemonExe"
                                Name="playitd.exe"
                                DiskId="1"
                                Source="$(var.BinDir)\playitd.exe"
                                KeyPath="yes"/>
                            <ServiceInstall
                                Id="PlayitServiceInstall"
                                Name="playitd"
                                DisplayName="playit.gg"
                                Description="Keeps your playit.gg tunnels online in the background."
                                Type="ownProcess"
                                Start="auto"
                                ErrorControl="normal"
                                Vital="yes"
                                Account="LocalSystem"
                                Arguments="--windows-service" />
                            <ServiceControl
                                Id="PlayitServiceStopRemove"
                                Name="playitd"
                                Stop="both"
                                Remove="uninstall"
                                Wait="yes" />
                            <!-- Wait="no": a slow first start must never fail the install. -->
                            <ServiceControl
                                Id="PlayitServiceStart"
                                Name="playitd"
                                Start="install"
                                Wait="no" />
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id="Binaries"
            Title="Application"
            Description="Installs playit, its background service, and the tray icon."
            Level="1"
            ConfigurableDirectory="APPLICATIONFOLDER"
            AllowAdvertise="no"
            Display="expand"
            Absent="disallow">

            <ComponentRef Id="PlayitCli"/>
            <ComponentRef Id="PlayitTray"/>
            <ComponentRef Id="PlayitDaemon"/>
            <ComponentRef Id="StartMenuShortcut"/>
            <ComponentRef Id="DesktopShortcut"/>
            <Feature
                Id="Environment"
                Title="PATH Environment Variable"
                Description="Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location."
                Level="1"
                Absent="allow">
                <ComponentRef Id="Path"/>
            </Feature>
        </Feature>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize"/>

        <!--
          Fresh interactive installs open playit so the user can finish setup. Everything
          else (upgrades, repairs, silent and winget installs) only brings the tray back.
          Interactive installs launch from the Finish button, which runs as the signed-in
          user without elevation.
        -->
        <CustomAction
            Id="LaunchTrayAndOpenPlayit"
            FileKey="PlayitTrayExe"
            ExeCommand="--open"
            Execute="immediate"
            Return="asyncNoWait" />
        <CustomAction
            Id="LaunchTray"
            FileKey="PlayitTrayExe"
            ExeCommand="--autostart"
            Execute="immediate"
            Return="asyncNoWait" />

        <InstallExecuteSequence>
            <Custom Action="LaunchTray" After="InstallFinalize">UILevel &lt; 5 AND NOT (REMOVE~="ALL")</Custom>
        </InstallExecuteSequence>

        <Icon Id="ProductICO" SourceFile="packages\playit-cli\wix\Product.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO" />

        <UI>
            <UIRef Id="WixUI_FeatureTree"/>

            <!-- Skip the license dialog. -->
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="99">1</Publish>
            <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99">1</Publish>

            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTrayAndOpenPlayit">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Publish>
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTray">NOT Installed AND WIX_UPGRADE_DETECTED</Publish>
        </UI>

        <!-- The banner BMP dimensions are 493 x 58 pixels. -->
        <WixVariable Id="WixUIBannerBmp" Value="packages\playit-cli\wix\Banner.bmp"/>
    </Product>
</Wix>
